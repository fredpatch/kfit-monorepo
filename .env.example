# K'FIT local development environment

# PostgreSQL
# Reserve host port 5432 for a native/local PostgreSQL installation.
# Docker publishes its internal 5432 port on host port 5433 by default.
POSTGRES_DB=kfit_dev
POSTGRES_USER=kfit
POSTGRES_PASSWORD=kfit_dev_password
POSTGRES_PORT=5433

# Host-side Drizzle / API connection to Docker PostgreSQL
DATABASE_URL=postgresql://kfit:kfit_dev_password@localhost:5433/kfit_dev

# Sprint 1 authentication policy (durations are milliseconds)
# Generate a unique secret with at least 32 random characters; never commit the real value.
AUTH_OTP_PEPPER=
# Optional dedicated pepper for one-way audit context hashes. Defaults to AUTH_OTP_PEPPER if unset.
AUTH_AUDIT_HASH_PEPPER=
# Optional dedicated pepper for refresh-token hashes. Defaults to AUTH_OTP_PEPPER if unset.
AUTH_REFRESH_TOKEN_PEPPER=
AUTH_OTP_TTL_MS=300000
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_FRESH_OTP_WINDOW_MS=600000
AUTH_ACCESS_TOKEN_TTL_MS=900000
AUTH_REFRESH_TOKEN_TTL_MS=604800000
AUTH_INACTIVITY_TIMEOUT_MS=1800000
AUTH_ABSOLUTE_SESSION_TTL_MS=43200000
AUTH_TRUSTED_DEVICE_TTL_MS=2592000000

# Dev SMTP sink (Mailpit)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=K'FIT Dev <noreply@kfit.local>
SMTP_TEST_TO=coach@kfit.local

# Dev malware scanner (ClamAV clamd)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Sprint 0 backup/restore pre-flight only.
# Generate a local 32-byte key, for example with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse this example/pre-flight key as a production backup key.
BACKUP_ENCRYPTION_KEY=
