# K'FIT local development environment

# PostgreSQL
POSTGRES_DB=kfit_dev
POSTGRES_USER=kfit
POSTGRES_PASSWORD=kfit_dev_password
POSTGRES_PORT=5432

# Host-side Drizzle / API connection
DATABASE_URL=postgresql://kfit:kfit_dev_password@localhost:5432/kfit_dev

# Dev SMTP sink (Mailpit)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=K'FIT Dev <noreply@kfit.local>
SMTP_TEST_TO=coach@kfit.local
