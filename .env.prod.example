# K'FIT production environment — copy to .env.prod on the production host.
# Never commit real secrets.

POSTGRES_DB=kfit_prod
POSTGRES_USER=kfit_prod
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_STRONG_SECRET

# Container-to-container connection. PostgreSQL is not exposed publicly.
DATABASE_URL=postgresql://kfit_prod:CHANGE_ME_WITH_A_STRONG_SECRET@postgres:5432/kfit_prod

# --- S7.4 : variables exigées au démarrage en production (le serveur refuse de démarrer si une valeur contient « change-me ») ---

# Application : URL publique en https et répertoires privés persistants (fichiers clients, journal de confidentialité).
KFIT_APP_BASE_URL=https://change-me.production.invalid
PRIVATE_STORAGE_ROOT=/change-me/kfit/private
KFIT_PRIVACY_JOURNAL_DIR=/change-me/kfit/privacy-journal

# Antivirus ClamAV : analyse de chaque fichier déposé.
CLAMAV_HOST=change-me-clamav-host
CLAMAV_PORT=change-me-3310

# E-mail (SMTP) : relais d'envoi des codes de vérification et des notifications.
SMTP_HOST=change-me-smtp-host
SMTP_PORT=change-me-587
SMTP_SECURE=change-me-true-or-false
SMTP_USER=change-me-smtp-user
SMTP_PASS=change-me-smtp-password
SMTP_FROM=change-me-sender-address

# Secrets d'authentification : 32 caractères minimum, tous différents (ex. openssl rand -base64 48).
AUTH_OTP_PEPPER=change-me-otp-pepper-at-least-32-characters
AUTH_AUDIT_HASH_PEPPER=change-me-audit-pepper-at-least-32-characters
AUTH_REFRESH_TOKEN_PEPPER=change-me-refresh-pepper-at-least-32-characters
AUTH_ACCESS_TOKEN_SECRET=change-me-access-secret-at-least-32-characters
AUTH_RECOVERY_TOKEN_SECRET=change-me-recovery-secret-at-least-32-characters
AUTH_DEVICE_PEPPER=change-me-device-pepper-at-least-32-characters

# --- S7.4b : sauvegardes chiffrées (scripts ops:*, lancés par un timer de l'hôte ; l'API ne lit pas ces variables) ---
# Clé de chiffrement : 64 caractères hexadécimaux (ex. openssl rand -hex 32), jamais affichée. Gardez-en une copie hors du serveur : sans elle, aucune restauration.
BACKUP_ENCRYPTION_KEY=change-me-64-hex-characters
# Deux répertoires distincts (le second sur un autre disque ou montage), hors de PRIVATE_STORAGE_ROOT et de KFIT_PRIVACY_JOURNAL_DIR.
BACKUP_DIR=/change-me/kfit/backups/primary
BACKUP_SECONDARY_DIR=/change-me/kfit/backups/secondary
# docker : pg_dump / pg_restore via docker compose exec dans le service postgres du fichier compose de production.
BACKUP_PG_MODE=docker
BACKUP_COMPOSE_FILE=/change-me/kfit/docker-compose.prod.yml
BACKUP_PG_SERVICE=postgres
