# TEST-01 D1: integration tests only (npm run db:test:prepare, npm run test:integration).
# Copy to .env.test (gitignored). Same credentials as DATABASE_URL in .env; only the database name differs.
# The guard accepts localhost or 127.0.0.1, port 5433, database kfit_test, no query string.
# Other variables still come from .env (loaded first); .env.test overrides them.
DATABASE_URL=postgresql://kfit:kfit_dev_password@localhost:5433/kfit_test
