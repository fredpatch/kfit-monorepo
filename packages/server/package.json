{
  "name": "@kfit/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test 'dist/**/*.test.js'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "preflight:otp": "node ./scripts/preflight/otp.mjs",
    "preflight:smtp": "node ./scripts/preflight/smtp.mjs",
    "preflight:files": "node ./scripts/preflight/files.mjs",
    "preflight:pdf": "node ./scripts/preflight/pdf.mjs",
    "preflight:jobs": "node ./scripts/preflight/jobs.mjs",
    "preflight:backup": "node ./scripts/preflight/backup-restore.mjs"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.5",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "puppeteer": "^24.16.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^6.4.18",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.2",
    "@types/express": "^5.0.3"
  }
}
